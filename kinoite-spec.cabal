cabal-version: 3.0
name: kinoite-spec
version: 0.1.0
synopsis: Declarative system convergence engine for Fedora Kinoite
description:
  kinoite-spec manages Fedora Kinoite systems from a declarative
  specification.
license: BSD-3-Clause
author: kinoite-spec contributors
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
      Src.Config
    , Src.Engine.Diff
    , Src.System.Flatpak
    , Src.System.Ostree
    , Src.Types.Action
    , Src.Types.CurrentState
    , Src.Types.Spec
    , Src.UI.Printer
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
      base >= 4.16 && < 5
    , bytestring
    , containers
    , text
    , yaml
    , aeson
    , typed-process
    , ansi-terminal

executable kinoite-spec
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
      base >= 4.16 && < 5
    , kinoite-spec
    , text
    , typed-process
    , optparse-applicative
    , ansi-terminal

test-suite config-tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
      base >= 4.16 && < 5
    , bytestring
    , containers
    , text
    , kinoite-spec
