cabal-version: 3.0
name: kinoite-spec
version: 0.1.0
synopsis: Declarative system convergence engine for Fedora Kinoite
description:
  kinoite-spec manages Fedora Kinoite systems from a declarative
  specification.
license: BSD-3-Clause
author: kinoite-spec contributors
build-type: Simple

executable kinoite-spec
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
      base >= 4.16 && < 5
    , text
    , bytestring
    , containers
    , yaml
    , aeson
    , typed-process
    , optparse-applicative
    , ansi-terminal
